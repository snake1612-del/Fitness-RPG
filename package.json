{
  "name": "fitness-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "local:start": "node scripts/local.mjs start",
    "local:status": "node scripts/local.mjs status",
    "local:stop": "node scripts/local.mjs stop",
    "local:migrate": "node scripts/local.mjs migrate",
    "dev:local": "node scripts/local.mjs dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check src scripts docs/LOCAL_DEVELOPMENT.md compose.local.yaml drizzle/meta drizzle.config.ts next.config.ts eslint.config.mjs package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts vitest.e2e.config.ts",
    "lint": "eslint src scripts drizzle.config.ts next.config.ts eslint.config.mjs vitest.config.ts vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@next/env": "16.3.8",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
