  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/env": "16.3.8",
    "@next/eslint-plugin-next": "16.3.8",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
