# Server only; never commit real credentials. LOCAL: use pnpm local:start / dev:local.
# LOCAL uses plain Docker PostgreSQL 17 at 127.0.0.1:55432 and keeps its secret stable.
# HOSTED uses Neon; do not copy hosted credentials into LOCAL, Preview or Development.
BETTER_AUTH_URL=https://your-application.example
BETTER_AUTH_SECRET=replace-me-with-a-secure-secret-at-least-32-characters
# Production only: Neon pooled endpoint; TLS is configured by the verified pg pool.
DATABASE_URL=postgresql://user:replace-me@your-pooler.example:5432/database
# Optional PEM trusted root; never disable certificate validation.
# DATABASE_SSL_CA=
# Trusted direct/unpooled Neon migration connection: local tooling only, never Vercel.
# MIGRATION_DATABASE_URL=postgresql://user:replace-me@your-direct-host.example:5432/database
