# Server-side Supabase Auth configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase transaction-mode pooler (port 6543). Do not use a direct connection at runtime.
DATABASE_URL=postgresql://postgres.your-project:replace-me@aws-0-your-region.pooler.supabase.com:6543/postgres
# Optional project root certificate from Supabase Database settings, if needed by TLS.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Optional, only for trusted migration tooling. Never used by application runtime.
# MIGRATION_DATABASE_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres
